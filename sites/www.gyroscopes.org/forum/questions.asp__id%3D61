  <tr>
    <td align="left" colspan="3" bgcolor="#663399"><h3>Question</h3></td>
  </tr>
  <tr>
    <td align="right" valign="top" nowrap><b>Asked by:</b></td>
    <td align="left" colspan="2" valign="top">dave</td>
  </tr>
  <tr>
    <td align="right" valign="top" nowrap><b>Subject:</b></td>
    <td align="left" colspan="2" valign="top">building a machine</td>
  </tr>
  <tr>
    <td align=right class=medium valign="top" nowrap><b>Question:</b></td>
    <td align=left class=medium valign="top" width="400" colspan="2">Any private individuals out there with funding for the building of a gyroscopic propulsion device?</td>
  </tr>
  <tr>
    <td align="right" valign="top" nowrap><b>Date:</b></td>

(* ==== small program in TurboPascal for calculation the G-constant === *)
(* complile and run   *)
program    gravity;
var        H:real;   (* Hubble constant *)
           Rp:real;  (* Proton radius, meters *)
           vp:real;  (* Proton spin velocity *)
           G:real;   (* Gravity constant *)
           Ap:real;  (* Proton interacting area *)
           Mp:real;  (* Proton mass *)
           Me:real;  (* Electron mass *)
           c:real;   (* Light velocity *)
           T:real;   (* Thermal background radiation in space, degrees *)
           S:real;   (* Stefan Boltzman constant *)
           Re:real;  (* Electron rest radius *)
           Pi:real;  (* The number of pi *)
           a1,a2,a3,a4,a5,a6,a7:real; (* common help variables *)
           hk,year:real;

Procedure presents;
begin
writeln('Written by O.Tedenstig, BASIC RESEARCH, Märsta/Sweden 1991');
writeln('Based on ideas in the book A NEW WAY TO PHYSICS 1991');
writeln('This program calculates the gravity constant out from');
writeln('the value of background radiation temperature in space');
writeln('and the Hubble constant');
writeln('The background temeperature is well known and determined');
writeln('but the Hubble constant is more unsure');
writeln('The model is not a results of an expanding universe');
writeln('but where the gravitation is a result of an absorbing process');
writeln('of matter into matter with a rate determined by the Hubble');
writeln('constant');
writeln('Matter all the time absorbe free thermal matter from space');
writeln('in a creating process. This absoption of matter from');
writeln('space in turn create some lack of matter in the vicinity');
writeln(' of the absorbing body, giving rise to an pushing force');
writeln('the gravity force');
 

(* -------------------------------------------------------------- *)
(* MATTER UNIFIED, 1998, ISBN 91-973340-0-6, O. Tedenstig/Sweden    Page 6.15  *)
(* -------------------------------------------------------------- *)

end;


procedure init;
begin
me:=9.109534E-31;              (* electron rest mass *)
c:=2.99792458E8;               (* light standard velocity *)
S:=5.6703271E-8;               (* Stefan Boltzman constant *)
Re:=2.817938070E-15;           (* classic electron radius *)
Pi:=4*arctan(1);
end;

Procedure compute;
begin
h:=hk*1E-18;
Mp:=1836.1515270*me;           (* proton mass *)
Rp:=Re*exp((1/3)*ln(Mp/me));   (* proton/neutron radius *)
Ap:=4*Pi*pi*Rp*Rp;             (* proton/neutron area *)
a1:=(1/H);
a2:=1/Mp;
vp:=T*T*SQRT(2*S*Ap*a1*a2);
a3:=H*vp;
a4:=a3*Ap;
a5:=4*pi*Mp;
G:=a4/a5;                      (* calculated gravity constant *)
year:=(1/(hk*1E-18))/(365*24*60*60)/1E9;
end;

Procedure printout;
begin
writeln('G calculated  = ',G);
writeln('G nominial= 6.672041E-11');
writeln('R = 1.25* H');
end;


procedure adjust_h;
var   h1,h2,dh:real;
      n,x:integer;
(* if H is not liniar with time because mass of a travelling *)
(* photon increases from its momentary mass value, the real H *)
(* value is larger than it appear to be *)
begin
x:=1000;
dh:=1/x;
h1:=1;
h2:=1;
for n:=1 to x do begin
 
(* -------------------------------------------------------------- *)
(* MATTER UNIFIED, 1998, ISBN 91-973340-0-6, O. Tedenstig/Sweden    Page 6.16  *)
(* -------------------------------------------------------------- *)
 
 
H1:=H1+dh;
H2:=H2+dh*H2;
end;
writeln('hk= ',h2/h1);
hk:=hk*(h2/h1);
end;


begin
init;
presents;
writeln('The official value of X is about 3 ');
write('Hubble constant X times 1E-18 '); readln(Hk);
Hk:=Hk*1.25; (*equal to rate *)
write('Thermal background radiation K (2.72) '); readln(T);

adjust_h;
compute;
printout;
readln;
writeln('The Hubble constant may be in the range of 5.1E-18');
writeln('to exactly fit in my model ');
end.
(* end of the program *)





TURBO_PASCAL PROGRAM FOR CALCULATION AND PLOT ON PC SCREEN
----------------------------------------------------------
program ballonwall;
(* Program written by O. Tedenstig   *)
(* Stockholm/Sweden 26/7-1997        *)
uses    graph;
label   1;

const   c=3E8;            (* light velocity m/s                           *)
        k=1E16;           (* steel ball spring constant                   *)
        m0_ball=1;        (* steel ball rest mass rel. to the wall        *)
        m_start=1.2;      (* + 20% steel ball relativistic mass           *)
        dt=1E-11;         (* incremental time interval                    *)
        k1=1.8E-8;        (* calculus plot constant                       *)
        k2=1.5E16;        (* calculus plot constant                       *)
var     dv_ball:real;     (* momentaneous change in velocity of ball      *)
        ds_spring:real;   (* momentaneous change in spring length         *)
        ds_ball:real;     (* the spring differential movement             *)
        dm_ball:real;     (* momentaneous change in ball rel. mass        *)
        f_spring:real;    (* momentan force in steel spring               *)
        m1_ball:real;     (* ball mass before incremental mass change     *)
        m2_ball:real;     (* ball mass after incremental mass change      *)
        m_ball:real;      (* momentan relativistic mass in ball           *)
        n:integer;        (* calculus parameter                           *)
        s_spring:real;    (* total change in spring length                *)
        s_ball:real;      (* the spring momentan movement                 *)
        t:real;           (* the total elapsed time                       *)
        v_start:real;     (* start velocity of steel ball                 *)
        v_ball:real;      (* the momentaneous velocity of ball            *)
        v_wall:real;      (* velocity of wall in case 2                   *)
        x,y:real;         (* help parameters                              *)
        graphdriver,graphmode,grapresult:integer;
        q,errorcode,frek:integer;
(************ procedure init graph ***********************)
procedure init_graph;
begin
graphdriver:=detect;
initgraph(graphdriver,graphmode,'c:\tp\BGI');
errorcode:=graphresult;
if errorcode <>grok then
begin
writeln('Graphics error: ',grapherrorMsg(errorCode));
writeln('program aborted..');
halt(1);
end;
setpalette(0,yellow);
end;

procedure present;
begin
Writeln('This program shows that Einsteins theory of relativity');
writeln('seems to be is wrong. It presents a test of the mass increase');
writeln('dogma in accord with the relativity basic concept.');
writeln('The problem is as follow: a steel ball collide with a massive ');
writeln('wall with a heavy mass. The ball and the wall are supposed');
 

(* -------------------------------------------------------------- *)
(* MATTER UNIFIED, 1998, ISBN 91-973340-0-6, O.Tedenstig/Sweden     Page 2.31 *)
(* -------------------------------------------------------------- *)
 
 
writeln('having an elasticity equivalent with a steel spring with');
writeln('a spring constant of, k. In the first case the steel ball');
writeln('collide with the wall with a relativistic velocity so high that');
writeln('the balls mass is 20% times greater than in the rest state.');
writeln('The time/force plot is calculated. In the second case the ');
writeln('collision happen when the ball is in rest and the wall is ');
writeln('coming with the same velocity as in the first case. The ');
writeln('time force plot is calculated as in the first place.');
writeln;
writeln('The force/time plot must be the same in both the cases.');
writeln('There shall not has any matter wether the ball or the wall');
writeln('moves, the plot must be symmetrical.');
writeln;
writeln('But it will not be symmetrical, the result depends on which');
writeln('side is regarded as moving at start.');
writeln('Hence, we can draw the conclusion that the mass increase concept');
writeln('as described by the relativistic concept seems to be erroneous.');
readln;
end;


procedure case1;
begin
ds_ball:=0;               (* reset ds ball parameter                  *)
dv_ball:=0;               (* reset dv_ball parameter                  *)
s_ball:=0;                (* reset ball start position                *)
ds_spring:=0;             (* reset ds spring prameter                 *)
s_spring:=0;              (* reset spring start position              *)
t:=0;                     (* reset time count parameter               *)
m_ball:=m_start;          (* define start ball start mass             *)
v_start:=c*sqrt((1-m0_ball/m_start));
v_ball:=v_start;          (* define ball initial velocity             *)
dm_ball:=0;
m1_ball:=m_start;
m2_ball:=m_start;


f_spring:=0.1;            (* for intrance of while loop               *)
while f_spring>0 do begin
f_spring:=0;              (* reset f_spring                           *)

ds_spring:=-(v_wall-v_ball)*dt;   (* change of spring compression     *)
s_spring:=s_spring+ds_spring;     (* spring compression               *)
ds_ball:=v_ball*dt;               (* change in ball position          *)
s_ball:=s_ball+ds_ball;           (* total change of ball position    *)
f_spring:=k*s_spring;             (* spring compression force         *)
dv_ball:=-(f_spring*dt-dm_ball*v_ball)/m_ball; (* change in ball velocity *)

v_ball:=v_ball+dv_ball;           (* total ball velocity              *)
t:=t+dt;                          (* the total elapsed time           *)
 
(* -------------------------------------------------------------- *)
(* MATTER UNIFIED, 1998, ISBN 91-973340-0-6, O.Tedenstig/Sweden     Page 2.32 *)
(* -------------------------------------------------------------- *)
 
 

m1_ball:=m_ball;
m_ball:=m0_ball/SQRT(1-(v_ball/c)*(v_ball/c));   (* mass in ball      *)
m2_ball:=m_ball;
dm_ball:=m2_ball-m1_ball;         (* change in ball mass              *)

putpixel(trunc(300*t/k1),trunc(300*f_spring/k2),red);
end;
end;

procedure case2;
var       mx,my:real;
begin
ds_ball:=0;               (* reset ds ball parameter                  *)
s_ball:=0;                (* reset ball start position                *)
ds_spring:=0;             (* reset ds spring prameter                 *)
s_spring:=0;              (* reset spring start position              *)
t:=0;                     (* reset time count parameter               *)
dm_ball:=0;               (* start velocity of steel ball             *)
m_ball:=m0_ball;          (* start mass of steel ball                 *)
v_ball:=0;                (* start velocity steel ball                *)
dm_ball:=0;               (* reset dm_ball help paramete              *)
m1_ball:=0;               (* reset m1_ball help parameter             *)
m2_ball:=0;               (* reset m2_ball help parameter             *)
v_wall:=v_start;          (* define start wall velocity               *)

f_spring:=0.1;            (* for intrance of while loop               *)
while f_spring>0 do begin
f_spring:=0;              (* reset f_spring force                     *)

ds_spring:=(v_wall-v_ball)*dt;(* momentaneout spring compression      *)
s_spring:=s_spring+ds_spring; (* total spring compression             *)
ds_ball:=v_ball*dt;           (* momentaneous change in ball position *)
s_ball:=s_ball+ds_ball;       (* total change in ball position        *)
f_spring:=k*s_spring;         (* spring force                         *)
dv_ball:=(f_spring*dt-dm_ball*v_ball)/m_ball;  (* change in ball velocity *)
v_ball:=v_ball+dv_ball;       (* total ball velocity                  *)
t:=t+dt;                      (* total elapsed time                   *)

m1_ball:=m_ball;
m_ball:=m0_ball/sqrt(1-v_ball/c*v_ball/c); (* actual ball mass        *)
m2_ball:=m_ball;
dm_ball:=m2_ball-m1_ball;     (* momentaneous change in ball mass     *)

putpixel(trunc(300*t/k1),trunc(300*f_spring/k2),blue);
end;
end;


(* -------------------------------------------------------------- *)
(* MATTER UNIFIED, 1998, ISBN 91-973340-0-6, O.Tedenstig/Sweden     Page 2.33 *)
(* -------------------------------------------------------------- *)


Procedure write_text;
begin
setcolor(red);
outtextxy(10,250,'Red curve = ball on wall');
setcolor(blue);
outtextxy(10,270,'Blue curve = wall on ball ');
setcolor(white);
outtextxy(10,290,'Horisontal axis = time axis ');
outtextxy(10,300,'Vertical axis = spring force axis ');
outtextxy(10,320,'The plot demonstrates that a "relativistic collision');
outtextxy(10,330,'between two masses with different weights, not ');
outtextxy(10,340,'is time symmetrical in respect to from which side');
outtextxy(10,350,'the collision is regarded, hence the relativistic');
outtextxy(10,360,'way to process such event seems to be erronous');
end;

begin

(************ write a program presentation on screen       *)
present;

(* initiate the program graph function                      *)
init_graph;

(************ The steel ball collide with the wall in rest  *)
case1;

(************ The steel wall collide with the ball in rest  *)
case2;

(************ Write text information in plot                *)
write_text;

(************ ending the program                            *)
readln;
closegraph;
end.



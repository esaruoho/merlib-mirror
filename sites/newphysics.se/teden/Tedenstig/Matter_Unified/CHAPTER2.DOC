a) m_start = 1.0 * m0                     Ball mass at start

b) v_start:=c*sqrt((1-m0_ball/m_start));  Wall velocity at start

c) ds_spring:=-(v_wall-v_ball)*dt;        Mom. compression of spring
   v_wall = v_start

d) s_spring:=s_spring+ds_spring;          Total compression of spring

e) ds_ball:=v_ball*dt;                    Mom change of ball postion

f) s_ball:=s_ball+ds_ball;                Total change of ball position

g) f_spring:=k*s_spring;                  Force stored in spring

h) dv_ball:=                              Mom. change in ball velocity
   (f_spring*dt-dm_ball*v_ball)/m_ball;

i) v_ball = v_ball+dv_ball                Mom. ball velocity

j) t:=t+dt;                               Total elapsed time

k) m_ball:=                               Mom. ball mass
   m0_ball/SQRT(1-(v_ball/c)*(v_ball/c));

l) dm_ball:=m2_ball-m1_ball;              Mom. change in ball mass
                                          at time t2,t1



  program positron(input,output);
  var     dEMev,f1,f2,df,dE,Tc,Mev,pi,rr,B,E,D,me,c,r,L,Fc,re:real;
  n,counter:integer;
  procedure init;
  begin
  pi:=4*arctan(1);
  re:=2.83E-15;(*classic electron radius*)
  me:=9.1E-31;(*electron rest mass*)
  c:=3E8;(*limit velocity of matter*)
  Mev:=0.511;(*energy of electron in Mega_Electron_Volt*)
  end;

  procedure compute_B;
  begin
  b:=1.1;
  repeat
  b:=b-1E-5;
  RR:=1-B*B-(2*n*B)*(2*n*B)*(2*n*B);
  until RR>=0;
  end;

  procedure compute_all;
  begin
  f1:=f2;
  L:=SQRT(1-B*B);
  D:=re*L/(4*B*B);
  fc:=(c/(4*pi*D))*(exp(-2/3*ln(L)));
  E:=2*Mev*(1/L);
  dE:=2*me*(1/L-1)*c*c;
  dEMev:=2*Mev*(1/L)*(1/L-1);
  f2:=fc;
  df:=f1-f2;
  end;

  begin
  writeln('Program started, please wait ');
  init;
  for n:=1 to 5 do begin
 
(* -------------------------------------------------------------- *)
(* MATTER UNIFIED, 1998, ISBN 91-973340-0-6, O. Tedenstig/Sweden   Page 4.47  *)
(* -------------------------------------------------------------- *)
 
 
  compute_b;compute_all;
  writeln('n= ',n);
  writeln('      B = ',b,  '       factor v/c ');
  writeln('      fc= ',fc, '       orbital frequency Hz ');
  writeln('      E=  ',E,  '       total system energy, 2*m*c(2), Mev');
  Writeln('      D=  ',D/re,'       Particle/center distance * times re ');
  writeln('      dE= ',dEMev  , '       difference energy rel. to rest Mev ');
  if n<>1 then   writeln('      dE/df = ', dE/df,' positronium Planck constant');
  end;
  readln;
  end.






(* COMPILED and RUN by TorboPascal *)
program interfer;

uses      Crt,graph;

label     1;
const     max=30000;pi=3.141592;
var       graphdriver,graphmode,grapresult:integer;
          xdel,T,errorcode:integer;
          str:string;
          yy,pp,n,nn,nnn:integer;
          x1corner,y1corner,x2corner,y2corner:integer;
          s,p1,p2,p,a,b,scal,f1,f2,r1,r2,r1q,r2q,d,w,x,y:real;
          result:real;

(* The program calculates the interference between two light  *)
(* rays passing through two slits in a screen, falling on a   *)
(* common flourscenting screen behind the first screen (the   *)
(* Young experiment. It's here supposed that the light photon *)
(* is a stream of free particles with density which fluctuate *)
(* with time of the  emitting source.                         *)

(* Observe that the unit "realstr" is special and may not     *)
(* be present in a  standard TurboPascal packet. It write     *)
(* out values of coordinates on screen at plotting            *)

(************* set palette light cyan *******************)
procedure set_palette;
 begin
 setpalette(0,lightcyan);
 end;

(************* rewrite the screen ************************)
 procedure rewrite_screen;
 var       pp,y1,y2,x1,x2:integer;
 begin
 setcolor(lightcyan);
 for pp:=1 to 650 do begin
 y1:=pp;y2:=pp;
 x1:=1;x2:=650;
 line(x1,y1,x2,y2);
 end;
 setcolor(red);
 end;
 
(* -------------------------------------------------------------- *)
(* MATTER UNIFIED, 1998, ISBN 91-973340-0-6, O. Tedenstig/Sweden    Page 5.84  *)
(* -------------------------------------------------------------- *)
 
 

(************ dets the palette to a disired color *********)
procedure set_pal_y;
begin
setpalette(0,yellow);
end;

(************* init graph mode ****************************)
procedure init_graph;
 begin
 graphdriver:=detect;
 initgraph(graphdriver,graphmode,'C:\tp\BGI');
 errorcode:=graphresult;
   if errorcode <>grok then
   begin
   writeln('Graphics error: ',grapherrorMsg(errorCode));
   writeln('program aborted..');
   halt(1);
   end;
end;



(**************** program start ****************************)
begin
yy:=0;
writeln('Stop with CNTRL+BREAK');
write('computer delay = 1 --> 1000 ');readln(xdel);

init_graph;
set_palette;


d:=1000000;   (* distance to screen in wave-length units *)
a:=1000;      (* distance between slits in wave-length units *)
w:=1;         (* the light wave length one unit *)
scal:=30E-3;
result:=d/a;
str:='D/E= '+str+'  w=1 ';
nnn:=0;
for n:=1 to max do begin
  x:=n+1-15000;
  r1:=sqrt((-a-x)*(-a-x)+d*d);
  r2:=sqrt((a-x)*(a-x)+d*d);
  f1:=abs(sin(2*pi*r1/w));
  f2:=abs(sin(2*pi*r2/w));
  a:=(1/d)*(1/d)*((-a-x)*r1*f1+(a-x)*r2*f2);
  b:=(1/d)*(1/d)*((d*r1*f1+d*r2*f2));
  p1:=sqrt(a*a+b*b);
  pp:=trunc(abs(p1)/scal)-50;
 
(* -------------------------------------------------------------- *)
(* MATTER UNIFIED, 1998, ISBN 91-973340-0-6, O. Tedenstig/Sweden    Page 5.85  *)
(* -------------------------------------------------------------- *)
 
 
if keypressed then goto 1;
  nn:=nn+1;

if nnn>14 then begin rewrite_screen;yy:=0;nnn:=0;end;

   if nn>=630 then begin
   nnn:=nnn+1;nn:=0;yy:=yy+30;
   result:=x;end;


if n=max-1 then n:=1;

begin putpixel(trunc(nn),(pp+yy),red);
                        putpixel(trunc(nn),(pp+yy+2),red);
                        putpixel(trunc(nn),(pp+yy+4),blue);
                        putpixel(trunc(nn),(pp+yy+6),red);
                        putpixel(trunc(nn),(pp+yy+8),red);
                        for T:=1 to xdel do begin
                        s:=sin(xdel);
                        end;
                        end;
                        end;
1: p:=p;
readln;
closegraph;
end.  (* program end *)




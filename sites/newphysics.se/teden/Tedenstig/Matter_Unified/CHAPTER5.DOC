program inclina;

var   B:real;   (* inclination in radian secons *)
      pi,M,G,c,R:real;
begin

M:=1.99E30;     (* sun radius *)
G:=6.67E-11;    (* gravity constant *)
c:=2.99793E8;   (* light velocity in vacou *)
R:=6.8E8;       (* sun radius *)
pi:=3.14;       (* mathematical constant, pi *)

       B:= 2*(M*G/R/(c*c) )*360*60*60/(2*pi);
writeln('Inclination angular seconds  = ',b);
readln;
end. (* end program *)


 

#!/usr/bin/env bash
set -euo pipefail

# Ensure homebrew tools (gh, python3) are in PATH
export PATH="/opt/homebrew/bin:$PATH"

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
PENDING_DIR="$REPO_DIR/queue/pending"
PROCESSING_DIR="$REPO_DIR/queue/processing"
DONE_DIR="$REPO_DIR/queue/done"
FAILED_DIR="$REPO_DIR/queue/failed"
SITES_DIR="$REPO_DIR/sites"

# Resolve mirror.py: $MIRROR_PY env var → PATH lookup → default
if [[ -z "${MIRROR_PY:-}" ]]; then
  if command -v mirror.py &>/dev/null; then
    MIRROR_PY="$(command -v mirror.py)"
  else
    MIRROR_PY="$REPO_DIR/mirror.py"
  fi
fi

# 1GB threshold in KB (1048576 KB = 1 GB)
MAX_PUSH_SIZE_KB=1048576

POLL_IDLE=300    # seconds between checks when queue is empty
POLL_ACTIVE=60   # seconds between jobs (mirrors are heavy)
RUN_ONCE=false
for arg in "$@"; do
  case "$arg" in
    --once)    RUN_ONCE=true ;;
    --verbose) export VERBOSE=1 ;;
  esac
done

log()  { echo "[$(date +%H:%M:%S)] $*"; }
idle() { [[ "${VERBOSE:-}" == "1" ]] && log "$*" || true; }

# Write PID so mirror-submit can wake us
PIDFILE="$REPO_DIR/.worker.pid"
echo $$ > "$PIDFILE"

# Heartbeat path — Syncthing carries this to the laptop, where
# merlib-mirror-status.sh reads it without SSH. Mirrors the pattern of
# ocr-heartbeat / whisp-heartbeat / voicebox-heartbeat.
HEARTBEAT_FILE="$HOME/work/comms/queue/merlib-mirror-heartbeat.json"
mkdir -p "$(dirname "$HEARTBEAT_FILE")" 2>/dev/null || true

# Counts each queue dir's .job files (excludes .gitkeep) and writes a
# fresh heartbeat JSON. Atomic via tmp+rename so the laptop never reads
# a half-written file. Pass current-job fields when processing; pass
# empty strings when idle/between.
write_heartbeat() {
  local status="$1"
  local target="${2:-}" mode="${3:-}" path_filter="${4:-}" domain="${5:-}" started="${6:-}"
  local pending processing done_ failed_
  pending=$(find "$PENDING_DIR" -maxdepth 1 -name '*.job' 2>/dev/null | wc -l | tr -d ' ')
  processing=$(find "$PROCESSING_DIR" -maxdepth 1 -name '*.job' 2>/dev/null | wc -l | tr -d ' ')
  done_=$(find "$DONE_DIR" -maxdepth 1 -name '*.job' 2>/dev/null | wc -l | tr -d ' ')
  failed_=$(find "$FAILED_DIR" -maxdepth 1 -name '*.job' 2>/dev/null | wc -l | tr -d ' ')
  local tmp="${HEARTBEAT_FILE}.tmp"
  cat > "$tmp" <<EOF
{
  "ts": $(date +%s),
  "ts_iso": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "status": "$status",
  "worker_pid": $$,
  "queue": {"pending": $pending, "processing": $processing, "done": $done_, "failed": $failed_},
  "current": {"target": "$target", "domain": "$domain", "mode": "$mode", "path_filter": "$path_filter", "started_at": "$started"}
}
EOF
  mv "$tmp" "$HEARTBEAT_FILE"
}

# Wipe progress file too, in case the previous worker died mid-crawl and
# left a stale snapshot. mirror.py rewrites it as soon as a crawl starts.
PROGRESS_FILE="$HOME/work/comms/queue/merlib-mirror-progress.json"

# Results dir lives in comms/queue so Syncthing carries every completion
# (success and failure) to the laptop, matching ocr-results / whisp-results /
# voicebox-results pattern. The laptop status pane reads from here. The
# spine.py ingest-mirror-results command (Phase 2) will also read from here.
MIRROR_RESULTS_DIR="$HOME/work/comms/queue/mirror-results"
mkdir -p "$MIRROR_RESULTS_DIR" 2>/dev/null || true

# Write a result.json for one completed (success or failure) job. Atomic via
# tmp+rename. Includes everything needed for: (a) laptop status pane to list
# recent finishes; (b) spine to create / update the mirror's asset.json.
write_result() {
  local status="$1"          # success | failed
  local domain="$2" mode="$3" target="$4" path_filter="$5" label="$6"
  local exit_code="$7" file_count="$8" size_bytes="$9" size_human="${10}"
  local started_at="${11}" completed_at="${12}" branch="${13}" pr_url="${14}"
  local site_dir="$SITES_DIR/$domain"

  # File-types breakdown straight from _meta.json if it exists
  local file_types_json="{}"
  if [[ -f "$site_dir/_meta.json" ]]; then
    file_types_json="$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(json.dumps(d.get('file_types', {})))" "$site_dir/_meta.json" 2>/dev/null || echo '{}')"
  fi

  local dest="$MIRROR_RESULTS_DIR/$domain"
  mkdir -p "$dest" 2>/dev/null || true
  local tmp="$dest/result.json.tmp"
  cat > "$tmp" <<EOF
{
  "schema_version": 1,
  "status": "$status",
  "exit_code": $exit_code,
  "domain": "$domain",
  "mode": "$mode",
  "target": "$target",
  "path_filter": "$path_filter",
  "label": "$label",
  "started_at": "$started_at",
  "completed_at": "$completed_at",
  "file_count": $file_count,
  "size_bytes": $size_bytes,
  "size_human": "$size_human",
  "file_types": $file_types_json,
  "branch": "$branch",
  "pr_url": "$pr_url",
  "site_dir": "$site_dir"
}
EOF
  mv "$tmp" "$dest/result.json"
}

cleanup() {
  rm -f "$PIDFILE"
  # On clean exit, write a final "stopped" heartbeat so the laptop status
  # pane shows accurate state instead of a stale "processing" snapshot.
  write_heartbeat "stopped" 2>/dev/null || true
}

# Drop a notify-inbox JSON so AppleToolbox renders a native banner on the
# receiving Mac. Schema per ~/work/apple/wiki/concepts/cloudcity-notify-inbox.md.
# Atomic .partial → .json rename so the watcher never sees a half-written file.
notify_drop() {
  local title="$1"
  local body="$2"
  local open_path="$3"
  local reveal_path="$4"
  local auto_open="${5:-}"   # "true" → AppleToolbox opens open_path on delivery, no click needed
  local inbox="$HOME/work/comms/queue/notify-inbox"
  [[ -d "$inbox" ]] || return 0   # if syncthing-shared comms isn't here, skip silently
  local ts host id partial final
  ts="$(date +%s)"
  host="$(hostname -s 2>/dev/null || echo unknown)"
  id="${ts}-${host}-mirror-$$"
  partial="$inbox/${id}.partial"
  final="$inbox/${id}.json"
  # Use python for JSON escaping so titles/bodies with quotes don't break the file.
  python3 - "$title" "$body" "$open_path" "$reveal_path" "$host" "$auto_open" >"$partial" <<'PYEOF'
import json, sys
title, body, open_path, reveal_path, host, auto_open = sys.argv[1:7]
payload = {"title": title, "sender": f"mirror-worker@{host}"}
if body:         payload["body"] = body
if open_path:    payload["open_path"] = open_path
if reveal_path:  payload["reveal_path"] = reveal_path
if auto_open == "true": payload["auto_open"] = True
print(json.dumps(payload, ensure_ascii=False))
PYEOF
  mv "$partial" "$final" 2>/dev/null || rm -f "$partial"
}
trap cleanup EXIT
trap 'log "Woken by signal"' USR1

WORKER_HASH=""

get_worker_hash() {
  md5 -q "$REPO_DIR/mirror-worker" "$REPO_DIR/start-mirror.sh" 2>/dev/null | md5 -q
}

sync_repo() {
  cd "$REPO_DIR"
  local pull_output
  pull_output="$(git pull --rebase --autostash 2>&1 || git pull 2>&1 || true)"

  if [[ "$pull_output" != *"Already up to date"* && "$pull_output" != *"up-to-date"* && -n "$pull_output" ]]; then
    log "Pulled updates: $pull_output"
  fi

  # Self-update: restart if worker scripts changed
  local new_hash
  new_hash="$(get_worker_hash)"
  if [[ -n "$WORKER_HASH" && "$new_hash" != "$WORKER_HASH" ]]; then
    log "Scripts updated — restarting worker..."
    exec "$REPO_DIR/mirror-worker"
  fi
  WORKER_HASH="$new_hash"
}

# Record a job claim in git by committing the .job file's removal from the tracked
# queue/pending/ dir. See the call site for why this is load-bearing: without it
# every pull re-materialises the job and the mirror re-runs forever.
claim_job_in_git() {
  local filename="$1"
  cd "$REPO_DIR" || return 1

  # Nothing tracked at that path (e.g. a locally-dropped job) → nothing to claim.
  if ! git ls-files --error-unmatch -- "queue/pending/$filename" >/dev/null 2>&1; then
    return 0
  fi

  git rm -q --cached --ignore-unmatch -- "queue/pending/$filename" || return 1
  git commit -q -m "queue: claim $filename (worker)" \
      -- "queue/pending/$filename" || return 1

  # Push so OTHER machines stop seeing the job as pending too. A push failure is
  # not fatal — the claim is committed locally and the next push carries it.
  git push -q origin HEAD || return 1
  log "Claimed $filename in git (removed from tracked queue/pending)"
  return 0
}

commit_and_push() {
  local msg="$1"
  local domain="$2"
  local site_dir="$3"   # absolute path to the job's output directory
  cd "$REPO_DIR"

  # Create (or recreate) a branch for this mirror job.
  # -B is idempotent: deletes any local branch of the same name and creates
  # fresh from main. Without this, a stale local branch from a prior run could
  # be checked out instead and overwrite today's freshly-crawled tracked files
  # (e.g. _meta.json, _mirror.log) with yesterday's committed versions — which
  # is exactly what happened to mirror/meyl.eu PR #33 (commit contained
  # yesterday's 5 stale files while disk had 178 fresh ones).
  local branch="mirror/${domain//[^a-zA-Z0-9._-]/-}"
  if ! git checkout -B "$branch" main 2>/dev/null; then
    log "WARNING: could not create branch $branch (checkout -B failed), committing to main"
    git checkout main 2>/dev/null || true
  fi

  # ONLY add files belonging to this job — never git add -A
  if [[ -d "$site_dir" ]]; then
    git add -- "$site_dir"
    # Record the other half of a www.<domain> → <domain> rename, if one just
    # happened (set by the normalisation block). Path-scoped, still never -A.
    if [[ -n "${NORMALISED_FROM:-}" ]]; then
      git add -- "$NORMALISED_FROM" 2>/dev/null || true
    fi
  else
    log "WARNING: site dir $site_dir does not exist, nothing to add"
    git checkout main 2>/dev/null
    return 0
  fi

  if git diff --cached --quiet 2>/dev/null; then
    log "No changes to commit for $domain"
    git checkout main 2>/dev/null
    return 0
  fi

  git commit -m "$msg"

  # Check size of site directory before pushing
  local size_kb
  size_kb="$(du -sk "$site_dir" 2>/dev/null | cut -f1)"
  local size_mb=$(( size_kb / 1024 ))

  # A large mirror is the POINT of this archive, so size alone must not stop it
  # reaching GitHub. This used to skip the push and `return 0` — reporting the job
  # as SUCCESS while the mirror existed only on the Mini's disk. That is the same
  # silent-loss shape as everything else this engine has been bitten by: it looks
  # done, and the content is one disk failure from gone.
  #
  # amasci.com is 974MB and still growing, i.e. about to cross this line.
  #
  # Now: warn loudly, then push anyway. Skipping requires an explicit opt-out, and
  # says so unmistakably when it happens.
  if [[ "$size_kb" -gt "$MAX_PUSH_SIZE_KB" ]]; then
    if [[ "${MIRROR_SKIP_LARGE_PUSH:-}" == "1" ]]; then
      log "!!! NOT PUSHED: $domain is ${size_mb}MB and MIRROR_SKIP_LARGE_PUSH=1."
      log "!!! The mirror exists ONLY on this machine. It is NOT retained."
      log "!!! Push it by hand: git -C $REPO_DIR push -u origin $branch"
      git checkout main 2>/dev/null
      return 1
    fi
    log "WARNING: $domain is ${size_mb}MB (over the ${MAX_PUSH_SIZE_KB}KB advisory) "
    log "         — pushing anyway; a mirror that is not pushed is not retained."
  else
    log "Size: ${size_mb}MB — under threshold, pushing"
  fi

  # "will retry next cycle" was a lie: by this point the job has been claimed and
  # moved to done/, so NOTHING retries it. A failed push meant the branch never
  # reached GitHub and the run still reported success. Retry here, then fail
  # loudly — a mirror that is not pushed is not retained.
  #
  # The push MUST tolerate a diverged remote branch. `git checkout -B "$branch" main`
  # above deliberately recreates the branch from CURRENT main, so re-mirroring a
  # domain whose branch already exists on the remote produces a history that shares
  # no tip with it — the old branch hangs off an older main. A plain `git push` is
  # then rejected non-fast-forward, every time, for every re-run.
  #
  # That is exactly how the 2026-08-12 newphysics.se re-run was lost: the crawl
  # fetched all 1201 files (260 more than the first run, including the whole Bearden
  # folder the redirect fix had just recovered), committed them locally, failed the
  # push 3x, and STILL reported success with the stale PR #59 attached. The branch on
  # GitHub never moved off the first run's commit.
  #
  # --force-with-lease, not --force: the remote branch is a previous attempt at THIS
  # job and is meant to be replaced, but if anything else moved it since our last
  # fetch we must still stop. The lease needs an up-to-date remote-tracking ref to
  # compare against, so fetch the branch first — without that, a stale ref makes the
  # lease pass when it should fail.
  git fetch -q origin "$branch" 2>/dev/null || true
  local push_ok=0
  for attempt in 1 2 3; do
    if git push --force-with-lease -u origin "$branch"; then push_ok=1; break; fi
    log "Push attempt $attempt/3 failed for $branch — retrying in $((attempt * 30))s"
    git fetch -q origin "$branch" 2>/dev/null || true
    sleep $((attempt * 30))
  done
  if [[ "$push_ok" -ne 1 ]]; then
    log "!!! PUSH FAILED 3x for $branch. The mirror is committed LOCALLY ONLY and"
    log "!!! is NOT retained. Nothing will retry this — the job is already claimed."
    log "!!! Recover by hand: git -C $REPO_DIR push -u origin $branch"
    git checkout main 2>/dev/null
    return 1
  fi

  local file_count
  file_count="$(find "$site_dir" -type f ! -name '_*' ! -name 'ALLFILES.txt' ! -name 'SOURCE.txt' 2>/dev/null | wc -l | tr -d ' ')"
  local size_human
  size_human="$(du -sh "$site_dir" 2>/dev/null | cut -f1)"

  # Build a rich PR body from SOURCE.txt + _meta.json. Falls back to a
  # one-liner if those files don't exist (older mirrors or pre-patch).
  local pr_body
  pr_body="$(python3 - "$site_dir" "$domain" "$file_count" "$size_human" <<'PYEOF'
import json, os, sys
site_dir, domain, file_count, size_human = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
source = {}
src_path = os.path.join(site_dir, "SOURCE.txt")
if os.path.exists(src_path):
    for line in open(src_path):
        if ':' in line:
            k, _, v = line.partition(':')
            source[k.strip()] = v.strip()
meta = {}
meta_path = os.path.join(site_dir, "_meta.json")
if os.path.exists(meta_path):
    try: meta = json.load(open(meta_path))
    except: pass
parts = []
parts.append(f"### Mirror of `{domain}`")
parts.append("")
target = source.get("target") or meta.get("source") or domain
parts.append(f"- **Source URL:** {target}")
mode = source.get("mode") or meta.get("source", "").replace("web.archive.org","wayback").replace("drive.google.com","gdrive").replace("dropbox.com","dropbox") or "?"
parts.append(f"- **Mode:** `{mode}`")
if source.get("path_filter"):
    parts.append(f"- **Path filter:** `{source['path_filter']}`")
if source.get("title"):
    parts.append(f"- **Page title:** {source['title']}")
if source.get("label"):
    parts.append(f"- **Label:** {source['label']}")
parts.append(f"- **Files:** {file_count}")
parts.append(f"- **Size:** {size_human}")
if source.get("mirror_date"):
    parts.append(f"- **Mirrored:** {source['mirror_date']}")
if meta.get("total_urls") is not None:
    parts.append(f"- **URLs discovered:** {meta.get('total_urls')}   downloaded: {meta.get('downloaded', '?')}   failed: {meta.get('failed', '?')}")
types = meta.get("file_types") or {}
if types:
    parts.append("")
    parts.append("**Top file types:**")
    for ext, n in sorted(types.items(), key=lambda x: -x[1])[:10]:
        parts.append(f"- `{ext}`: {n}")
parts.append("")
parts.append("See [`ALLFILES.txt`](../tree/HEAD/sites/" + domain + "/ALLFILES.txt) for full file list and [`SOURCE.txt`](../tree/HEAD/sites/" + domain + "/SOURCE.txt) for provenance.")
parts.append("")
parts.append("🤖 Generated by mirror-worker")
print("\n".join(parts))
PYEOF
)"

  # Create PR
  if command -v gh &>/dev/null; then
    if echo "$pr_body" | gh pr create --title "$msg" --body-file - --base main --head "$branch" 2>/dev/null; then
      log "PR created for $domain"
    else
      log "WARNING: gh pr create failed for $domain"
    fi
  else
    log "WARNING: gh CLI not installed, branch pushed but no PR created"
  fi

  log "Pushed branch $branch: $domain ($file_count files, $size_human)"

  # Return to main. Housekeeping — it must NOT decide this function's verdict.
  git checkout main 2>/dev/null || log "WARNING: could not switch back to main"

  # Explicit, and load-bearing. Without it the function's status was whatever the
  # `git checkout main` above happened to exit with, and the caller now propagates
  # that status into result.json. On 2026-08-12 the newphysics.se re-run pushed
  # 1419 files to the branch successfully — the Bearden, Puthoff, Hyde, Bailey,
  # JosephNewman, LaViolette, Rognerud and Persson subtrees all landed — and was
  # still recorded as FAILED with the job moved to failed/, because of the trailing
  # checkout. The meaning of success here is exactly one thing: the branch reached
  # the remote. `gh pr create` failing (a PR for this branch already exists, which
  # is the norm on a re-mirror) and the checkout failing are both survivable.
  return 0
}

process_job_file() {
  local job_file="$1"
  local filename
  filename="$(basename "$job_file")"

  # Cleared per job — a rename recorded for one domain must not leak into the
  # next job's commit.
  NORMALISED_FROM=""

  # Extract fields from the .job file
  local target domain mode path_filter ts_to label offline to_syncthing
  target="$(grep '^target:' "$job_file" | head -1 | sed 's/^target: *//')"
  domain="$(grep '^domain:' "$job_file" | head -1 | sed 's/^domain: *//')"
  mode="$(grep '^mode:' "$job_file" | head -1 | sed 's/^mode: *//')"
  path_filter="$(grep '^path_filter:' "$job_file" | head -1 | sed 's/^path_filter: *//' || true)"
  ts_to="$(grep '^ts_to:' "$job_file" | head -1 | sed 's/^ts_to: *//' || true)"
  label="$(grep '^label:' "$job_file" | head -1 | sed 's/^label: *//' || true)"
  offline="$(grep '^offline:' "$job_file" | head -1 | sed 's/^offline: *//' || true)"
  to_syncthing="$(grep '^to_syncthing:' "$job_file" | head -1 | sed 's/^to_syncthing: *//' || true)"
  # to_syncthing implies offline (no git push)
  [[ "$to_syncthing" == "true" ]] && offline="true"

  if [[ -z "$domain" || -z "$mode" ]]; then
    log "ERROR: Missing domain or mode in $filename"
    mv "$job_file" "$FAILED_DIR/$filename"
    echo "error: missing domain or mode" >> "$FAILED_DIR/$filename"
    return 1
  fi

  echo ""
  log "━━━ MERLib Mirror — New job ━━━━━━━━━━━━━━━━"
  log "Domain: $domain"
  log "Mode:   $mode"
  [[ "$offline" == "true" ]] && log "Offline: YES (download only, no commit/push)"
  [[ "$to_syncthing" == "true" ]] && log "→ Syncthing: YES (output to comms/queue/gdrive-results/)"
  log "Target: $target"

  # Move to processing
  mv "$job_file" "$PROCESSING_DIR/$filename"

  # ── claim the job IN GIT, or it runs forever ──────────────────────────────
  # queue/pending/ is TRACKED; queue/processing|done|failed/ are gitignored. So
  # moving the .job file only claims it on THIS machine — the deletion from
  # queue/pending/ is never recorded, and the next `git pull` re-materialises the
  # job file and the whole mirror runs again.
  #
  # 2026-08-04: exactly that happened. radiondistics was re-mirrored a second
  # time, opening duplicate PRs #55 and #56 for work already merged in #52 and
  # closed in #53, and force-updating mirror/radiondistics.com. The amasci
  # Wayback backfill would have looped the same way, indefinitely.
  #
  # Committing the removal is what actually claims the job. Path-scoped, never
  # -A. Non-fatal: a push failure must not stop a good mirror — the job is
  # already out of pending locally, and the next successful push carries it.
  if [[ "$offline" != "true" ]]; then
    claim_job_in_git "$filename" || \
      log "NOTE: could not record job claim in git (next push will carry it)"
  fi

  # Capture start time for the result.json we write on completion.
  local started_at
  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  # Tell the status pane on the laptop what we're working on now. Atomic
  # write so a reader never sees a half-built file.
  write_heartbeat "processing" "$target" "$mode" "$path_filter" "$domain" "$started_at"

  # Clear any stale error.log from a prior failed run on this same domain.
  # Otherwise: a job fails (writes error.log), gets resubmitted later, runs
  # to completion, and commit_and_push includes the OLD error.log in the
  # successful PR — the PR bot then warns "error.log present, exit non-zero"
  # even though THIS run succeeded. error.log is a per-run signal; treat it
  # that way.
  rm -f "$SITES_DIR/$domain/error.log" 2>/dev/null || true

  # Choose output directory:
  #   to_syncthing=true  → comms/queue/gdrive-results/ (Syncthing-mirrored, small/medium content
  #                        that should come back to the laptop)
  #   offline=true       → repo/offline/ (4TB local archive, never pushed)
  #   otherwise          → sites/ (normal mirror, committed + pushed)
  local output_dir="$SITES_DIR"
  if [[ "$to_syncthing" == "true" ]]; then
    output_dir="$HOME/work/comms/queue/gdrive-results"
    mkdir -p "$output_dir"
  elif [[ "$offline" == "true" ]]; then
    output_dir="$REPO_DIR/offline"
    mkdir -p "$output_dir"
  fi

  # Build mirror.py command
  local mirror_args=()

  if [[ "$mode" == "wayback" ]]; then
    mirror_args=(wayback "$domain" --resume --output-dir "$output_dir")
    if [[ -n "$path_filter" ]]; then
      mirror_args+=(--path "$path_filter")
      log "Path filter: $path_filter"
    fi
    if [[ -n "$ts_to" ]]; then
      mirror_args+=(--to "$ts_to")
      log "Timestamp cap: --to $ts_to"
    fi
  elif [[ "$mode" == "live" ]]; then
    mirror_args=(live "$target" --output-dir "$output_dir")
    # Pass path_filter through in live mode too (mirror.py >= path-filter-in-live).
    # Without this, live-mode BFS spiders across the whole domain via outbound
    # links — the samlib.ru 327k-URL incident from May 2026.
    if [[ -n "$path_filter" ]]; then
      mirror_args+=(--path "$path_filter")
      log "Path filter: $path_filter"
    fi
  elif [[ "$mode" == "gdrive" ]]; then
    mirror_args=(gdrive "$target" --output-dir "$output_dir")
    if [[ -n "$label" ]]; then
      mirror_args+=(--label "$label")
    fi
  elif [[ "$mode" == "dropbox" ]]; then
    mirror_args=(dropbox "$target" --output-dir "$output_dir")
    if [[ -n "$label" ]]; then
      mirror_args+=(--label "$label")
    fi
  else
    log "ERROR: Unknown mode '$mode'"
    mv "$PROCESSING_DIR/$filename" "$FAILED_DIR/$filename"
    echo "error: unknown mode $mode" >> "$FAILED_DIR/$filename"
    return 1
  fi

  log "Running: python3 $MIRROR_PY ${mirror_args[*]}"

  # Run mirror.py. Pipe through tee but capture mirror.py's exit code
  # (not tee's) so a crash/SIGKILL of the crawler is detected.
  local site_dir="$output_dir/$domain"
  # tee opens the log file at startup. For fresh jobs (gdrive especially —
  # each `gdrive-<ID>` is brand new) the dir doesn't exist yet (mirror.py
  # creates it inside). Without this mkdir, tee fails 1, pipefail surfaces
  # it as the pipeline exit, and an otherwise-successful job is marked failed.
  mkdir -p "$site_dir" 2>/dev/null || true
  local exit_code=0
  set -o pipefail
  # ── keep the heartbeat fresh WHILE the crawl runs ─────────────────────────
  # write_heartbeat was called only at job start and between jobs. The guardian
  # kills the worker when the heartbeat is older than STALE_THRESHOLD_S=600, so
  # ANY job longer than ten minutes was killed mid-crawl as "STUCK". The belt
  # structurally could not complete a long job.
  #
  # From merlib-mirror-guardian.log on 2026-08-04, amasci Wayback backfill queued:
  #   11:44:33 mirror-worker pid=95108 STUCK (heartbeat 607s old > 600s) — killing
  #   11:55:12 mirror-worker pid=5011  STUCK (heartbeat 606s old > 600s) — killing
  #   12:05:51 mirror-worker pid=14699 STUCK (heartbeat 607s old > 600s) — killing
  # Three kills, zero progress, repeating forever. A ~20,000-URL Wayback crawl
  # takes hours and never got past ten minutes.
  #
  # The heartbeat means "this worker is alive", and it IS alive while the crawler
  # runs — so refresh it every 60s for the duration. Not a daemon, not nohup: a
  # subshell supervised by this worker, dying with it.
  python3 "$MIRROR_PY" "${mirror_args[@]}" 2>&1 | tee "$site_dir/_mirror_worker.log" 2>/dev/null &
  local mirror_pid=$!
  while kill -0 "$mirror_pid" 2>/dev/null; do
    write_heartbeat "processing" "$target" "$mode" "$path_filter" "$domain" "$started_at"
    sleep 60
  done
  # Exit code still comes from the pipeline, not tee — verified a pipeline exiting
  # 7 still surfaces 7, so a crashed / OOM-killed crawler is still detected.
  wait "$mirror_pid" || exit_code=$?
  set +o pipefail

  # Job is over (success or failure) — wipe the per-job progress snapshot
  # so the status pane doesn't show a stuck "in-flight" forever. The
  # heartbeat envelope below will reflect between_jobs/failed/done state.
  rm -f "$PROGRESS_FILE" 2>/dev/null || true

  # Compute file count + size now (used by both paths' result.json)
  local file_count=0 size_bytes=0 size_human="0"
  if [[ -d "$site_dir" ]]; then
    file_count="$(find "$site_dir" -type f ! -name '_*' ! -name 'ALLFILES.txt' ! -name 'SOURCE.txt' ! -name 'error.log' 2>/dev/null | wc -l | tr -d ' ')"
    size_bytes="$(du -sk "$site_dir" 2>/dev/null | awk '{print $1*1024}')"
    size_human="$(du -sh "$site_dir" 2>/dev/null | cut -f1)"
  fi
  local completed_at
  completed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local branch="mirror/$domain"

  if [[ "$exit_code" -ne 0 ]]; then
    log "FAILED: mirror.py exited with code $exit_code for $domain (137 = SIGKILL, likely OOM or external kill)"
    mkdir -p "$site_dir" 2>/dev/null || true
    echo "$completed_at mirror.py exit code $exit_code" >> "$site_dir/error.log"
    # Move job to failed/, NOT done/. Crashed jobs aren't successes; calling
    # them done loses the signal that we should retry or look at them.
    mkdir -p "$FAILED_DIR"
    mv "$PROCESSING_DIR/$filename" "$FAILED_DIR/$filename"
    log "Moved $filename to failed/ (exit $exit_code)"
    # Emit result.json to comms so the laptop sees the failure too.
    write_result "failed" "$domain" "$mode" "$target" "$path_filter" "$label" \
                 "$exit_code" "$file_count" "$size_bytes" "$size_human" \
                 "$started_at" "$completed_at" "" ""
    # For syncthing-bound jobs, also ping the laptop's notification center.
    if [[ "$to_syncthing" == "true" ]]; then
      notify_drop \
        "❌ gdrive failed: $domain" \
        "exit $exit_code — see error.log" \
        "$site_dir/error.log" \
        "$site_dir"
    fi
    log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    return 0
  fi

  # Success path — move to done and commit
  mv "$PROCESSING_DIR/$filename" "$DONE_DIR/$filename"

  # ── www. normalisation ────────────────────────────────────────────────────
  # mirror.py's live crawler names its output dir from urlparse().hostname
  # (e.g. "www.radiondistics.altervista.org") while the job's `domain:` field
  # is the stripped host ("radiondistics.altervista.org"). commit_and_push
  # only stages "$output_dir/$domain", so a live crawl of a www-hosted site
  # committed nothing but its own log. (2026-07-29: radiondistics — 218 files
  # crawled OK, PR #49 contained only _mirror_worker.log.) Fold the www. dir
  # into the canonical one instead of losing it.
  if [[ ! -d "$site_dir" || -z "$(ls -A "$site_dir" 2>/dev/null | grep -v '^_mirror_worker.log$')" ]] \
     && [[ -d "$output_dir/www.$domain" ]]; then
    log "Normalising output dir: www.$domain → $domain"
    mkdir -p "$site_dir"
    if ( cd "$output_dir/www.$domain" && tar cf - . ) | ( cd "$site_dir" && tar xf - ); then
      rm -rf "$output_dir/www.$domain"
      # The www. dir may be TRACKED (an earlier buggy run committed it under
      # that name). rm -rf leaves the deletion unstaged, and commit_and_push
      # only stages "$site_dir" — so the rename would be half-recorded: the
      # PR adds the canonical path but never drops the stale one, leaving a
      # duplicate on main and phantom deletions for the repo-puller to fight.
      # Hand the old path to commit_and_push so both halves land in one commit.
      # FEATURE-CARD >> features/frameset-following.feature
      NORMALISED_FROM="$output_dir/www.$domain"
      log "Normalised ($(find "$site_dir" -type f | wc -l | tr -d ' ') files)"
    fi
  fi

  # ── consolidation stage: mirror → ONE cohesive paper ─────────────────────
  # Storing the original is only half the job. A mirror is N scattered pages;
  # synthesis needs one text. site_to_paper.py emits per-page markdown
  # (KeelyNet-style frontmatter) plus <domain>-CONSOLIDATED.md in the site's
  # OWN reading order (BFS over its link graph). Autonomous, zero-token,
  # idempotent. Never fatal: a consolidation failure must not fail a good mirror.
  if [[ -f "$REPO_DIR/scripts/site_to_paper.py" ]]; then
    log "Consolidating site → single paper"
    python3 "$REPO_DIR/scripts/site_to_paper.py" "$site_dir" 2>&1 \
      | tee -a "$site_dir/_mirror_worker.log" \
      || log "WARNING: consolidation failed (mirror itself is fine)"
  fi

  # ── longform stage: mirror → ONE readable/printable document ─────────────
  # The markdown paper above is for grep and for feeding a model. This is the
  # other shape: allpages.html (+ .pdf) — every page in reading order, images
  # inline, and every internal "click here to see yet another page" link
  # rewritten to an in-document anchor. Same reading order as the paper (both
  # use site_to_paper.reading_order), so they are one document in two shapes.
  # Never fatal: a longform failure must not fail a good mirror.
  # FEATURE-CARD >> features/allpages-longform.feature
  if [[ -f "$REPO_DIR/scripts/site_to_allpages.py" ]]; then
    log "Consolidating site → longform allpages.html (+PDF)"
    python3 "$REPO_DIR/scripts/site_to_allpages.py" "$site_dir" \
        --pdf-max-pages 300 2>&1 \
      | tee -a "$site_dir/_mirror_worker.log" \
      || log "WARNING: longform failed (mirror itself is fine)"
  fi

  # Commit and push — unless offline mode. commit_and_push echoes the PR URL
  # to its own log; we re-derive it from the branch for the result.json.
  local pr_url=""
  local push_status=0
  if [[ "$offline" == "true" ]]; then
    log "Offline mode — files saved locally, skipping commit and push"
  else
    # The return value is load-bearing. It used to be discarded, and write_result
    # below said "success" unconditionally — so a push that failed 3x, or a stage
    # that found nothing to commit, was reported to the laptop as a completed
    # mirror. Worse, the PR URL was then re-derived from the branch name, which
    # happily returned the PREVIOUS run's still-open PR: the status pane showed a
    # green result pointing at a PR that did not contain the new content.
    commit_and_push "mirror: $domain" "$domain" "$site_dir" || push_status=$?
    # Best-effort PR URL lookup — works once the PR exists. Only when the push
    # actually landed; otherwise this attaches a stale PR to a failed run.
    if [[ "$push_status" -eq 0 ]] && command -v gh &>/dev/null; then
      pr_url="$(gh pr view "$branch" --repo "$(git -C "$REPO_DIR" remote get-url origin | sed -E 's#.*[:/]([^/]+/[^.]+)(\.git)?$#\1#')" --json url --jq .url 2>/dev/null || true)"
    fi
  fi

  # A mirror that is not pushed is not retained — so it is not a success. Move the
  # job out of done/ and into failed/ so it stops blocking resubmission and can be
  # retried once the push problem is fixed. (The crawled files stay on disk; a
  # re-run is cheap because mirror.py skips anything already downloaded.)
  if [[ "$push_status" -ne 0 ]]; then
    log "!!! Recording $domain as FAILED: the mirror never reached GitHub."
    mkdir -p "$FAILED_DIR"
    mv "$DONE_DIR/$filename" "$FAILED_DIR/$filename" 2>/dev/null || true
    write_result "failed" "$domain" "$mode" "$target" "$path_filter" "$label" \
                 "$push_status" "$file_count" "$size_bytes" "$size_human" \
                 "$started_at" "$completed_at" "$branch" ""
    log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    return 0
  fi

  # Emit result.json to comms so the laptop status pane (and spine) sees
  # every completed mirror.
  write_result "success" "$domain" "$mode" "$target" "$path_filter" "$label" \
               "0" "$file_count" "$size_bytes" "$size_human" \
               "$started_at" "$completed_at" "$branch" "$pr_url"

  # For syncthing-bound jobs, ping the laptop's notification center.
  # Click the banner → AppleToolbox foregrounds (unavoidable for LSUIElement
  # menu-bar apps when the UN-delegate didReceive doesn't fire) AND Finder
  # opens the folder. AppleToolbox detects its own activation as the click
  # signal and opens the pending open_path within a 5-min window.
  if [[ "$to_syncthing" == "true" ]]; then
    notify_drop \
      "📥 gdrive done: $domain" \
      "$file_count files, $size_human" \
      "$site_dir" \
      "$site_dir"
  fi

  log "Done: $domain"
  log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  return 0
}

recover_processing() {
  # On startup, move any stuck processing files back to pending
  local count=0
  for f in "$PROCESSING_DIR"/*.job; do
    [[ -f "$f" ]] || continue
    mv "$f" "$PENDING_DIR/$(basename "$f")"
    ((count++)) || true
  done
  if [[ "$count" -gt 0 ]]; then
    log "Recovered $count stuck job(s) from processing queue."
  fi
}

# Pull any new .job files from the comms inbox (Syncthing-mirrored from any
# peer) into our local PENDING_DIR. mv-then-remove so the same job can't be
# double-claimed if a second peer also drops it. Idempotent: if the same
# filename already exists in any of pending/processing/done/failed/, the
# inbox copy is discarded silently.
COMMS_INBOX="$HOME/work/comms/queue/mirror-inbox"
pull_comms_inbox() {
  [[ -d "$COMMS_INBOX" ]] || return 0
  local f base
  for f in "$COMMS_INBOX"/*.job; do
    [[ -f "$f" ]] || continue
    base="$(basename "$f")"
    # Skip if we've already seen this job
    if [[ -f "$PENDING_DIR/$base" || -f "$PROCESSING_DIR/$base" || -f "$DONE_DIR/$base" || -f "$FAILED_DIR/$base" ]]; then
      rm -f "$f"
      continue
    fi
    cp "$f" "$PENDING_DIR/$base.staging"
    mv "$PENDING_DIR/$base.staging" "$PENDING_DIR/$base"
    rm -f "$f"
    log "Pulled from comms inbox: $base"
  done
}

# --- Main loop ---

log "MERLib Mirror worker starting"
log "Mirroring the Internet's Modern Energy Research into a Library"
log "Repo: $REPO_DIR"
log "Mirror engine: $MIRROR_PY"
log "Output: $SITES_DIR"

recover_processing
sync_repo
pull_comms_inbox
write_heartbeat "starting"

while true; do
  # Check the comms inbox each loop so peer submissions (laptop, etc.) get
  # picked up promptly.
  pull_comms_inbox

  # Pick the oldest pending .job file (FIFO by filename = unix timestamp)
  next_file=""
  for f in "$PENDING_DIR"/*.job; do
    [[ -f "$f" ]] || continue
    next_file="$f"
    break
  done

  if [[ -z "$next_file" ]]; then
    if [[ "${SHOWED_IDLE:-}" != "1" ]]; then
      log "Waiting for mirror requests..."
      SHOWED_IDLE=1
    fi
    write_heartbeat "idle"
    sleep "$POLL_IDLE"
    sync_repo
    continue
  fi

  # A job arrived — reset idle flag
  SHOWED_IDLE=""

  process_job_file "$next_file" || true
  write_heartbeat "between_jobs"

  if [[ "$RUN_ONCE" == true ]]; then
    log "Single job mode (--once). Exiting."
    exit 0
  fi

  sleep "$POLL_ACTIVE"
  sync_repo
done
